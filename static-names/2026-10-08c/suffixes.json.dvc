outs:
- path: suffixes.json
meta:
  computation:
    cmd: SPOT=1 JOB_ID=sn-2026-10-08c-map-$(date -u +%H%M%S) ../../job/static-names.sh run suffix-map 32 -g 2026-10-08c -I 2026-10-08 -C -n 8 > /dev/null && SPOT=1 JOB_ID=sn-2026-10-08c-shards-$(date -u +%H%M%S) ../../job/static-names.sh run shards 32 -g 2026-10-08c > /dev/null && dt-cloud static-names sidecar -g 2026-10-08c > suffixes.json
    deps:
      cintervals.json: ''
      shards.json: ''
    git_deps:
      ../../cloud/src/dt_cloud/static_names.py: ''
