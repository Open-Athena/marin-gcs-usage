outs:
- path: catalog-short.json
meta:
  computation:
    cmd: SPOT=1 MODULE=static_catalog JOB_ID=sn-2026-10-08c-short-$(date -u +%H%M%S) ../../job/static-names.sh run short 32 -g 2026-10-08c -n 8 > /dev/null && dt-cloud static-names manifest -b oa-gcs-usage-scratch -g 2026-10-08c catalog-short > catalog-short.json
    deps:
      cintervals.json: ''
    git_deps:
      ../../cloud/src/dt_cloud/static_catalog.py: ''
