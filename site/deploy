#!/usr/bin/env bash
# Build and deploy to Cloudflare Pages: https://cw-s3.oa.dev (project
# oa-cw-s3-usage, Open Athena account). CF Access (Zero Trust) gates every
# hostname — cw-s3.oa.dev and the *.oa-cw-s3-usage.pages.dev URLs.
set -euo pipefail
cd "$(dirname "$0")"

# `--status`: report whether HEAD is deployed (no build/deploy). Delegates to the
# standalone `cf-status` (queries the CF Pages deployments API, compares to HEAD).
if [ "${1:-}" = "--status" ]; then exec ./cf-status; fi

# Push is the DEFAULT (same as gcs's deploy): what's on cw-s3.oa.dev belongs on
# GitHub too, or agents reading the repo infer from stale source.
# `-P`/`--no-push` keeps a deploy local.
push=true
for a in "$@"; do case "$a" in -P|--no-push) push=false ;; esac; done

# Auth via the repo's direnv CLOUDFLARE_API_TOKEN, which has Pages write on the
# OA account (as well as Access + oa.dev DNS edit). We deliberately do NOT fall
# back to `wrangler login` OAuth: that session tends to drift to a personal
# account and then fails with auth error 10000 against the OA account.
pnpm build
CLOUDFLARE_ACCOUNT_ID=74981a43be0de7712369306c7b19133d \
  npx wrangler pages deploy dist --project-name oa-cw-s3-usage --branch main

if $push; then
  branch=$(git rev-parse --abbrev-ref HEAD)
  git push o "$branch" || echo "WARN: push of $branch to o failed (deploy itself succeeded)" >&2
  echo "pushed $branch → o (GitHub)"
fi
