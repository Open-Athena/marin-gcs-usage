#!/usr/bin/env bash
# Full local app = vite (UI, :3263) + `wrangler pages dev` (the /data +
# /v1/files Pages Functions, :3264, reading GCS HMAC creds from .dev.vars).
# vite proxies the API paths to wrangler (see vite.config.ts), so the treemap
# and the scan browser both work locally against the live bucket.
#
#   ./dev        # then open http://localhost:3263
#
# (`pnpm dev` alone runs only vite → blank treemap, since /data isn't served.)
set -euo pipefail
cd "$(dirname "$0")"

# wrangler dies now and then (memory pressure, a dropped tunnel) and takes
# /data with it — relaunch it until this script is stopped.
(
  while :; do
    npx wrangler pages dev public --port 3264 --compatibility-date 2026-01-01 || true
    echo "wrangler exited; restarting in 3s (ctrl-c to stop)" >&2
    sleep 3
  done
) &
wpid=$!
trap 'kill "$wpid" 2>/dev/null || true; pkill -P "$wpid" 2>/dev/null || true' EXIT INT TERM
pnpm dev
