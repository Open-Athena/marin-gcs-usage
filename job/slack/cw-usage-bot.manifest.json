{
  "_metadata": {
    "major_version": 1,
    "minor_version": 1
  },
  "display_information": {
    "name": "CoreWeave Usage Bot",
    "description": "Storage-usage digest for the Marin CoreWeave bucket — cw-s3.oa.dev",
    "background_color": "#0d1117"
  },
  "features": {
    "bot_user": {
      "display_name": "CoreWeave Usage Bot",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "chat:write.customize",
        "chat:write.public",
        "channels:history",
        "groups:history",
        "channels:read",
        "groups:read",
        "users:read",
        "emoji:read"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
