#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["click", "pyyaml"]
# ///
"""Fan this branch's Pulumi stack outputs out to the places the app reads them.

The stack's R2 credentials (`r2_s3_access_key_id` / `r2_s3_secret_access_key`)
and ids are secret outputs that never enter git. This reads them once
(`pulumi stack output --show-secrets --json`, with the IaC token from the root
`.envrc`) and, without ever printing a value:

  * writes them into an `.envrc` block (default: THIS worktree's `.envrc`, never
    the repo root's — each deployment branch owns its own) under per-deployment names, e.g.
    `CW_S3_R2_ENDPOINT`, `CW_S3_R2_BUCKET`, `CW_S3_R2_ACCESS_KEY_ID`,
    `CW_S3_R2_SECRET_ACCESS_KEY`, `CW_S3_CACHE_KV_ID`;
  * `-p/--pages`: `wrangler pages secret put` the site's `STORE_*` seam
    (endpoint / key id / secret) on the stack's Pages project's `preview`
    environment (the dev stack); `-P/--prod` adds production, which must ship
    together with the `[vars]` `STORE_BUCKET`/`STORE_REGION` flip;
  * `-g/--gsm`: Secret Manager `cw-s3-r2-{endpoint,access-key-id,secret-access-key}`
    for the Batch job (`job/cw-batch-submit.sh` maps them to `R2_*`), new
    version if the secret exists, plus `secretAccessor` for the job SA.

Values are handed to every subprocess on stdin, raw (no trailing newline —
wrangler and gcloud store stdin verbatim). `-n` prints the plan by name only.
"""
from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from functools import partial
from pathlib import Path

import click
import yaml

err = partial(print, file=sys.stderr)

CF_DIR = Path(__file__).resolve().parent
ROOT = CF_DIR.parent
# This worktree's own direnv file (`wt/<branch>/.envrc`, `source_up` for the
# shared OA tokens) — a deployment's vars never go into the repo-root `.envrc`,
# which belongs to the gcs checkout (writing there rehashes it and blocks direnv
# for that session until re-allowed; 2026-09-28).
ENVRC = ROOT / ".envrc"
GCP_PROJECT = "oa-internal-450019"
GCP_ACCOUNT = "ryan.williams@openathena.ai"
JOB_SA = f"gcs-usage-job@{GCP_PROJECT}.iam.gserviceaccount.com"


def envrc_token(name: str) -> str:
    """The IaC token: the environment (direnv has loaded it) first, else the
    nearest `.envrc` walking up from this worktree (its own, then the repo
    root's via `source_up`)."""
    if os.environ.get(name):
        return os.environ[name]
    for d in [ROOT, *ROOT.parents]:
        f = d / ".envrc"
        if not f.exists():
            continue
        for line in f.read_text().splitlines():
            m = re.match(rf'\s*export\s+{name}=(["\']?)(.+?)\1\s*$', line)
            if m:
                return m.group(2)
    raise click.ClickException(f"{name} not in the environment or any .envrc above {ROOT}")


def stack_outputs(stack: str, token: str) -> dict[str, str]:
    env = {**os.environ, "CLOUDFLARE_API_TOKEN": token, "CLOUDSDK_CORE_ACCOUNT": GCP_ACCOUNT}
    out = subprocess.run(
        ["pulumi", "stack", "output", "--show-secrets", "--json", "-s", stack],
        cwd=CF_DIR, env=env, check=True, capture_output=True, text=True,
    ).stdout
    return json.loads(out)


def stack_config(stack: str) -> dict[str, str]:
    cfg = yaml.safe_load((CF_DIR / f"Pulumi.{stack}.yaml").read_text())["config"]
    return {k.split(":", 1)[1]: v for k, v in cfg.items() if isinstance(v, str)}


def run_stdin(cmd: list[str], value: str, env: dict[str, str], cwd: Path | None = None) -> None:
    r = subprocess.run(cmd, input=value, env=env, cwd=cwd, capture_output=True, text=True)
    if r.returncode != 0:
        # Never echo stdin; the tool's own stderr doesn't contain the value.
        raise click.ClickException(f"{' '.join(cmd)} failed ({r.returncode}):\n{r.stderr.strip()}")


def write_envrc_block(path: Path, stack: str, values: dict[str, str]) -> None:
    start, end = f"# >>> cf/sync-secrets {stack} >>>", f"# <<< cf/sync-secrets {stack} <<<"
    block = "\n".join([start, f"# {stack} stack outputs (pulumi stack output --show-secrets); regenerate with cf/sync-secrets"]
                      + [f"export {k}={v}" for k, v in values.items()] + [end])
    text = path.read_text()
    pat = re.compile(rf"{re.escape(start)}.*?{re.escape(end)}", re.S)
    text = pat.sub(lambda _: block, text) if pat.search(text) else text.rstrip("\n") + "\n\n" + block + "\n"
    path.write_text(text)


@click.command()
@click.option("-e", "--envrc", type=click.Path(path_type=Path), default=ENVRC, show_default=True, help="direnv file to write the block into")
@click.option("-g", "--gsm", is_flag=True, help="also push the job's secrets to Secret Manager (+ accessor grant)")
@click.option("-n", "--dry-run", is_flag=True, help="print the plan (names only), write nothing")
@click.option("-p", "--pages", is_flag=True, help="also `wrangler pages secret put` the site's STORE_* on the preview (dev stack) environment")
@click.option("-P", "--prod", is_flag=True, help="…and on production — only together with the `[vars]` STORE_BUCKET/STORE_REGION flip")
@click.option("-s", "--stack", default="cw-s3", show_default=True, help="Pulumi stack (this branch's)")
def main(envrc: Path, gsm: bool, dry_run: bool, pages: bool, prod: bool, stack: str) -> None:
    token = envrc_token("CF_IAC_TOKEN")
    cfg = stack_config(stack)
    account = cfg["accountId"]
    out = stack_outputs(stack, token)
    prefix = re.sub(r"[^A-Z0-9]", "_", stack.upper())
    r2 = {
        f"{prefix}_R2_ENDPOINT": f"https://{account}.r2.cloudflarestorage.com",
        f"{prefix}_R2_BUCKET": out["r2_bucket"],
        f"{prefix}_R2_ACCESS_KEY_ID": out["r2_s3_access_key_id"],
        f"{prefix}_R2_SECRET_ACCESS_KEY": out["r2_s3_secret_access_key"],
    }
    values = {**r2, f"{prefix}_CACHE_KV_ID": out["cache_kv_id"]}
    err(f"[{stack}] outputs → {envrc}: {', '.join(values)}")
    if not dry_run:
        write_envrc_block(envrc, stack, values)

    store = {  # the site's store seam (functions/_lib/index.ts storeCreds)
        "STORE_ENDPOINT": r2[f"{prefix}_R2_ENDPOINT"],
        "STORE_ACCESS_KEY_ID": r2[f"{prefix}_R2_ACCESS_KEY_ID"],
        "STORE_SECRET_ACCESS_KEY": r2[f"{prefix}_R2_SECRET_ACCESS_KEY"],
    }
    if pages or prod:
        project = out["pages_project"]
        wenv = {**os.environ, "CLOUDFLARE_ACCOUNT_ID": account, "CLOUDFLARE_API_TOKEN": token}
        # Production only on explicit request: a seam-aware build with the
        # STORE_* creds present but `STORE_BUCKET` unset reads R2 with the GCS
        # bucket name and 404s every data route (2026-09-25 hotfix incident) —
        # the creds and the `[vars]` flip must ship together.
        for env_name in (["preview"] if pages else []) + (["production"] if prod else []):
            for k, v in store.items():
                cmd = ["npx", "wrangler", "pages", "secret", "put", k, "--project-name", project]
                if env_name == "preview":
                    cmd += ["--env", "preview"]
                err(f"[{stack}] pages {project}/{env_name}: {k}")
                if not dry_run:
                    run_stdin(cmd, v, wenv, cwd=ROOT / "site")

    if gsm:
        names = {  # job/cw-batch-submit.sh secretVariables → R2_*
            f"{stack}-r2-endpoint": store["STORE_ENDPOINT"],
            f"{stack}-r2-access-key-id": store["STORE_ACCESS_KEY_ID"],
            f"{stack}-r2-secret-access-key": store["STORE_SECRET_ACCESS_KEY"],
        }
        genv = {**os.environ, "CLOUDSDK_CORE_ACCOUNT": GCP_ACCOUNT, "CLOUDSDK_CORE_PROJECT": GCP_PROJECT}
        for name, v in names.items():
            exists = subprocess.run(["gcloud", "secrets", "describe", name, "--format=value(name)"], env=genv, capture_output=True, text=True).returncode == 0
            verb = ["versions", "add", name] if exists else ["create", name, "--replication-policy=automatic"]
            err(f"[{stack}] gsm {name}: {'new version' if exists else 'create'} + accessor → {JOB_SA}")
            if not dry_run:
                run_stdin(["gcloud", "secrets", *verb, "--data-file=-"], v, genv)
                subprocess.run(
                    ["gcloud", "secrets", "add-iam-policy-binding", name, f"--member=serviceAccount:{JOB_SA}",
                     "--role=roles/secretmanager.secretAccessor", "--format=none"],
                    env=genv, check=True, capture_output=True, text=True,
                )


if __name__ == "__main__":
    main()
