#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["click"]
# ///
"""Put the app-session sign-in secrets on this deployment's Pages project
(specs/done/oidc-cutover-cw.md P2) without ever printing a value:

  SESSION_SECRET   fresh 48 random bytes (base64) — ONE value for preview and
                   production, because the dev stack shares the production D1
                   (a session minted on one host must verify on the other);
                   generated once and kept in `<worktree>/tmp/.session-secret`
                   (mode 600) so a later `-P` reuses it — delete that file when
                   both environments carry it.
  RESEND_API_KEY   the shared send-only key, from the environment (`$oa/.envrc`).
  MAIL_FROM        "Open Athena <noreply@oa.dev>" (verified sender in Resend).

The Google client pair is NOT set here: the auth repo's
`scripts/provision-oauth-client.mjs --from-json … --pages-project <project> --run`
does that from the Console's downloaded JSON (one client per deployment).
`-p` = preview (the dev stack; do this first, verify sign-in on
dev.<project>.pages.dev), `-P` = production; `-n` prints the plan only.
"""
from __future__ import annotations

import base64
import os
import re
import secrets
import subprocess
import sys
from functools import partial
from pathlib import Path

import click

err = partial(print, file=sys.stderr)

ROOT = Path(__file__).resolve().parent.parent
SITE = ROOT / "site"
ACCOUNT_ID = "74981a43be0de7712369306c7b19133d"  # Open Athena
SECRET_FILE = ROOT / "tmp" / ".session-secret"
MAIL_FROM = "Open Athena <noreply@oa.dev>"


def pages_project() -> str:
    m = re.search(r'^name = "([^"]+)"', (SITE / "wrangler.toml").read_text(), re.M)
    if not m:
        raise click.ClickException(f"no `name = …` in {SITE / 'wrangler.toml'}")
    return m.group(1)


def session_secret(dry_run: bool) -> str:
    if SECRET_FILE.exists():
        return SECRET_FILE.read_text().strip()
    value = base64.b64encode(secrets.token_bytes(48)).decode()
    if dry_run:
        return value  # nothing persisted on a dry run
    SECRET_FILE.parent.mkdir(parents=True, exist_ok=True)
    SECRET_FILE.touch(mode=0o600)
    SECRET_FILE.write_text(value)
    return value


def put(name: str, value: str, project: str, env_name: str, dry_run: bool) -> None:
    cmd = ["npx", "wrangler", "pages", "secret", "put", name, "--project-name", project]
    if env_name == "preview":
        cmd += ["--env", "preview"]
    err(f"[{project}/{env_name}] {name}")
    if dry_run:
        return
    r = subprocess.run(cmd, input=value, env={**os.environ, "CLOUDFLARE_ACCOUNT_ID": ACCOUNT_ID}, cwd=SITE, capture_output=True, text=True)
    if r.returncode != 0:
        # never echo stdin; wrangler's stderr doesn't contain the value
        raise click.ClickException(f"{' '.join(cmd)} failed ({r.returncode}):\n{r.stderr.strip()[-600:]}")


@click.command()
@click.option("-n", "--dry-run", is_flag=True, help="print the plan (names only), write nothing")
@click.option("-p", "--preview", is_flag=True, help="the preview environment (dev stack) — first")
@click.option("-P", "--prod", is_flag=True, help="production — after sign-in is verified on the dev stack")
def main(dry_run: bool, preview: bool, prod: bool) -> None:
    if not (preview or prod):
        raise click.UsageError("pick -p (preview) and/or -P (production)")
    resend = os.environ.get("RESEND_API_KEY")
    if not resend:
        raise click.ClickException("RESEND_API_KEY not in the environment (direnv loads it from $oa/.envrc)")
    project = pages_project()
    values = {"SESSION_SECRET": session_secret(dry_run), "RESEND_API_KEY": resend, "MAIL_FROM": MAIL_FROM}
    for env_name in (["preview"] if preview else []) + (["production"] if prod else []):
        for k, v in values.items():
            put(k, v, project, env_name, dry_run)
    err(f"session secret kept in {SECRET_FILE} (mode 600) until both environments carry it — then delete it")


if __name__ == "__main__":
    main()
